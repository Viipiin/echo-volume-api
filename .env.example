PORT=5005
# Optional: require header  x-api-key: <value>  on every /api call
API_KEY=

# India account (amazon.in). For amazon.com use: amazon.com / pitangui.amazon.com / en-US
AMAZON_PAGE=amazon.in
ALEXA_SERVICE_HOST=alexa.amazon.in
ACCEPT_LANGUAGE=en-IN

# Login proxy port (used only for first sign-in)
PROXY_PORT=3001

# Name exactly as shown in the Alexa app, so you can omit "device" in calls
DEFAULT_DEVICE=

# Name Alexa knows your TV by (what you'd say: "Alexa, turn on <TV_NAME>")
TV_NAME=TV

# SmartThings (optional, for Samsung TV). Create an OAuth-In app with the SmartThings CLI:
#   smartthings apps:create   -> redirect URI https://httpbin.org/get, scopes r:devices:* x:devices:*
ST_CLIENT_ID=
ST_CLIENT_SECRET=
ST_REDIRECT_URI=https://httpbin.org/get
# Optional: pick the TV explicitly (GET /api/st/devices lists device IDs)
ST_TV_DEVICE_ID=
# Optional: extra app buttons, e.g. [{"name":"ZEE5","appId":"<tizen app id>"}]
ST_TV_APPS=

# Optional: Apple Music catalog country (default follows AMAZON_PAGE, amazon.in -> IN)
MUSIC_COUNTRY=
# Optional: minimum gap between voice-style commands sent to Amazon, in ms (Amazon rate-limits bursts)
COMMAND_GAP_MS=1500
