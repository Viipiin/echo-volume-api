{
  "name": "echo-volume-api",
  "productName": "Echo Volume",
  "version": "5.2.0",
  "description": "Control Echo Show and Samsung TV volume from your laptop",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "icons": "node scripts/make-icon.js",
    "dist": "electron-builder --win nsis",
    "build:app": "electron-builder --win dir -c.directories.output=dist-app",
    "build:payload": "node installer/scripts/make-payload.js",
    "build:installer": "node installer/scripts/make-splash.js && electron-builder --win portable --config installer/electron-builder.json",
    "build:all": "npm run build:app && npm run build:payload && npm run build:installer",
    "setup": "electron installer/main.js"
  },
  "dependencies": {
    "alexa-remote2": "^8.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "local.echovolume.app",
    "productName": "Echo Volume",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "smartthings.js",
      "alexa-features.js",
      "moods.js",
      "focus-presets.js",
      "amazon-limiter.js",
      "activity-log.js",
      "release-notes.js",
      "mood-player.js",
      "desktop/**",
      "public/**",
      "installer/uninstall-main.js",
      "installer/preload.js",
      "installer/lib/common.js",
      "installer/lib/uninstall.js",
      "installer/lib/window.js",
      "installer/renderer/**",
      "build/icon.png",
      "build/tray.png",
      ".env.example",
      "package.json",
      "!.env",
      "!cookie.json",
      "!st-token.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signtoolOptions": {
        "publisherName": "Vipin Kumar",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Echo Volume"
    },
    "copyright": "Vipin Kumar"
  }
}
